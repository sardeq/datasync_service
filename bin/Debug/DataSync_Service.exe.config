<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="DataSync_Service.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>

  <connectionStrings>
    <add name="DbSource" connectionString="Server=(localdb)\MSSQLLocalDB;Database=Sadeq_sourceDb;Integrated Security=True;" providerName="System.Data.SqlClient" />
    <add name="DbDest" connectionString="Server=(localdb)\MSSQLLocalDB;Database=Sadeq_destinationDb;Integrated Security=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <applicationSettings>
    <DataSync_Service.Properties.Settings>
      <setting name="DataSync_Service_WebServiceRef_WebService" serializeAs="String">
        <value>https://localhost:44380/WebService.asmx</value>
      </setting>
    </DataSync_Service.Properties.Settings>
  </applicationSettings>
</configuration>